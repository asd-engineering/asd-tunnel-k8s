# asd-tunnel-k8s environment configuration
# Used by: asd env init, asd expose, automation tasks

# Tunnel server (kind cluster NodePort)
ASD_TUNNEL_HOST=localhost
ASD_TUNNEL_PORT=30022

# Auth mode: "none" for base/minimal, "key" for file-auth, "mock" for testing
ASD_TUNNEL_AUTH_MODE=none

# Cluster settings
CLUSTER_NAME=asd-tunnel-demo
NAMESPACE=asd-tunnel-demo
OVERLAY=minimal

# Tunnel test settings
TUNNEL_DOMAIN=tunnel.local
TUNNEL_HTTP_PORT=30080
TUNNEL_CADDY_PORT=30443    # NodePort → Caddy sidecar (container port 8443, tls internal)
TUNNEL_SSH_PORT=30022
TUNNEL_HOST=127.0.0.1
SUBDOMAIN=app
LOCAL_PORT=getRandomPort()

# Docs demo
DOCS_PORT=getRandomPort()
DOCS_SUBDOMAIN=docs
